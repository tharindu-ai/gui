<Page x:Class="ToDoApp.TaskEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Edit Task">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Edit Task" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center"/>

            <TextBox Name="TaskNameTextBox" Width="400" Height="40" Margin="5"/>
            <TextBox Name="TaskDescriptionTextBox" Width="400" Height="65" Margin="5" AcceptsReturn="True"/>

            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                <ComboBox Name="HourComboBox" Width="60"/>
                <TextBlock Text=":" VerticalAlignment="Center" FontSize="16"/>
                <ComboBox Name="MinuteComboBox" Width="60"/>
                <ComboBox Name="AmPmComboBox" Width="80"/>
            </StackPanel>

            <Button Content="Save Changes" Click="SaveChangesButton_Click" FontWeight="SemiBold" Margin="5"/>
            <Button Content="Cancel" Click="CancelButton_Click" FontWeight="SemiBold" Margin="5"/>
        </StackPanel>
    </Grid>
</Page>

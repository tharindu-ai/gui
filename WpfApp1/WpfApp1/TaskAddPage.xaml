<Page x:Class="ToDoApp.TaskAddPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Add Task">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Add Task" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center"/>

            <TextBox Name="TaskNameTextBox" Width="400" Height="40" Margin="5" FontWeight="DemiBold"
                     Text="Task Name" Foreground="Gray"
                     GotFocus="TaskNameTextBox_GotFocus" 
                     LostFocus="TaskNameTextBox_LostFocus"/>

            <TextBox Name="TaskDescriptionTextBox" Width="400" Height="65" Margin="5" FontWeight="DemiBold"
                     Text="Task Description" Foreground="Gray"
                     GotFocus="TaskDescriptionTextBox_GotFocus" 
                     LostFocus="TaskDescriptionTextBox_LostFocus" AcceptsReturn="True"/>

            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                <ComboBox Name="HourComboBox" Width="60"/>
                <TextBlock Text=":" VerticalAlignment="Center" FontSize="16"/>
                <ComboBox Name="MinuteComboBox" Width="60"/>
                <ComboBox Name="AmPmComboBox" Width="80"/>
            </StackPanel>

            <Button Content="Save Task" Click="SaveTaskButton_Click" FontWeight="SemiBold" Margin="5"/>
            <Button Content="Back" Click="BackButton_Click" FontWeight="SemiBold" Margin="5"/>
        </StackPanel>
    </Grid>
</Page>

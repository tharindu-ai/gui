<Page x:Class="ToDoApp.TaskSavePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Saved Tasks">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Saved Tasks" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Name="TaskCountTextBlock" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>

            <!-- Task List with Buttons -->
            <ListBox Name="TaskListBox" Width="450" Height="250" SelectionChanged="TaskListBox_SelectionChanged"/>

            <!-- Action Buttons (Disabled by default) -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                <Button Name="EditButton" Content="Edit Task" Click="EditTaskButton_Click" FontWeight="SemiBold" Width="100" IsEnabled="False"/>
                <Button Name="DeleteButton" Content="Delete Task" Click="DeleteTaskButton_Click" FontWeight="SemiBold" Width="100" IsEnabled="False"/>
            </StackPanel>

            <Button Content="Back" Click="BackButton_Click" FontWeight="SemiBold" Margin="5" Width="150"/>
        </StackPanel>
    </Grid>
</Page>

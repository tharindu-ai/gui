<Page x:Class="ToDoApp.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Home Page">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Welcome to To-Do List" FontSize="45" FontWeight="SemiBold" Margin="15" Foreground="Black" HorizontalAlignment="Center"/>

            
            <Button Content="Add Task" Click="AddTaskButton_Click" Margin="5" FontWeight="SemiBold" Foreground="Black" FontSize="22" Height="42"/>

            
            <Button Content="View Tasks" Click="ViewTasksButton_Click" Margin="5" Height="40" FontWeight="SemiBold" Foreground="Black" FontSize="22" RenderTransformOrigin="0.5,0.5">
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform AngleX="1.364"/>
                        <RotateTransform/>
                        <TranslateTransform X="0.476"/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>

            
            <Button Content="Log Out" Click="LogOutButton_Click" Margin="5" FontWeight="SemiBold" Width="161"/>
        </StackPanel>
    </Grid>
</Page>

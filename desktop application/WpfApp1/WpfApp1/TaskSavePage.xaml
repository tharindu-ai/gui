<Page x:Class="ToDoApp.TaskSavePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Saved Tasks">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Saved Tasks" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Name="TaskCountTextBlock" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>

            <ListBox Name="TaskListBox" Width="450" Height="250" 
                     MouseDoubleClick="TaskListBox_MouseDoubleClick"
                     ContextMenuOpening="TaskListBox_ContextMenuOpening"/>

            <Button Content="Back" Click="BackButton_Click" FontWeight="SemiBold" Margin="5" Width="150"/>
        </StackPanel>
    </Grid>
</Page>
